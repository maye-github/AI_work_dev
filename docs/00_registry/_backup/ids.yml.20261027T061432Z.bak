# ============================================================
# trans-cosmos-ai AI 全流程骨架 - ID 発号統合レジストリ
# 唯一発号口（NFR-1 単一ソース）。野号は tools/trace_check.py gate1 で Exit 1。
# 発号規則: 3桁起步、連番、不使用番号の再利用禁止（void で明示的に無効化）
# status 値域: draft / open / baselined / changed / done / void
# ============================================================
registry:
  description: "朝日ビール R60 共通マスタ 开球周 ID 発号本（R60Area 貫通例）"
  owner: AI-SE
  version: 0.1.0
  started: 2026-10-08
  prefixes:
    R: "Requirements（要求）"
    Q: "Quality（確認事項・QA票）"
    F: "Functional Spec（機能仕様）"
    I: "Interface/Data Item（画面項目・I/O）"
    D: "Data Model（DML/物理設計）"
    L: "Logic/Function（業務ロジック）"
    E: "Event/Error（エラー・イベント）"
    TC: "Test Case（テストケース・工程⑥）"
    IT: "Integration Test（結合・総合テスト・工程⑦）"
    CR: "Change Request（変更要求）"
    BUG: "Bug Report（不具合）"

