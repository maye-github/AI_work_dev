{
  "_comment": "trans-cosmos-ai 案件固有の機密識別子パターン。実値をここに書いた版を secret_patterns.local.json として作成すること（.gitignore 済み）。この example はプレースホルダのみで、__ で始まる regex はローダがスキップする。",
  "_usage": [
    "1. cp tools/trace_check/secret_patterns.example.json tools/trace_check/secret_patterns.local.json",
    "2. local 側の regex を実パターン（接続ユーザ名 / S3 バケット名 / AWS プロファイル / Auth0 テナント等）に置換",
    "3. python -m tools.trace_check --strict --only-check secrets"
  ],
  "patterns": [
    {
      "label": "Oracle 接続ユーザ",
      "regex": "__REPLACE_WITH_LOCAL_REGEX__ \\bdb_user_example\\b"
    },
    {
      "label": "S3 バケット名",
      "regex": "__REPLACE_WITH_LOCAL_REGEX__"
    },
    {
      "label": "AWS プロファイル",
      "regex": "__REPLACE_WITH_LOCAL_REGEX__"
    },
    {
      "label": "Auth0 テナント",
      "regex": "__REPLACE_WITH_LOCAL_REGEX__"
    }
  ]
}
